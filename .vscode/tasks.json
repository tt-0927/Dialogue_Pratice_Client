{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: build client",
            "type": "shell",
            "command": "cmake -S ${workspaceFolder} -B ${workspaceFolder}/build -DCMAKE_BUILD_TYPE=Release && cmake --build ${workspaceFolder}/build -j$(nproc)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run: client",
            "type": "shell",
            "command": "${workspaceFolder}/build/bin/dialogue_client",
            "dependsOn": ["cmake: build client"],
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "reveal": "always"
            }
        }
    ]
}
